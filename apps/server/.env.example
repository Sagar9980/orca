# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Postgres. Create the database once: createdb orca
DATABASE_URL=postgres://localhost:5432/orca

# Public URL of this server; links in emails point here.
BETTER_AUTH_URL=http://localhost:4000
# 32+ random characters. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Web app origins allowed to call the API with cookies (comma-separated).
WEB_ORIGINS=http://localhost:5173

# Email. "resend" sends for real; "log" prints emails to this terminal (development only).
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="Orca <auth@yourdomain.com>"

# Social sign-in (optional; each provider turns on when both values are set).
# GitHub callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
