{
  "name": "@orca/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@orca/shared": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0"
  }
}
