{
  "name": "@orca/engine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "fix": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@orca/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.4.0",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
