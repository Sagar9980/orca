{
  "name": "orca",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently -n server,web,desktop -c blue,green,magenta \"pnpm --filter @orca/server dev\" \"pnpm --filter @orca/web dev\" \"pnpm --filter @orca/desktop dev\"",
    "dev:web": "pnpm --filter @orca/web dev",
    "dev:server": "pnpm --filter @orca/server dev",
    "dev:desktop": "pnpm --filter @orca/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
